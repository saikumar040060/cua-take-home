{
  "capability_id": "meridian_open_new_share",
  "name": "Open a new share for a member",
  "goal": "Sign on to MERIDIAN CORE as the given operator, look up the member by member number, and open a new share of the given share type with the given initial deposit. Go through the review step, read the hidden per-transaction security token off the page, then post it. Read back the confirmation reference after posting.",
  "entry_url": "https://web-sample.interface-hiring.com/",
  "inputs": [
    {"name": "operator_id", "value": "teller1", "description": "Operator login ID.", "sensitivity": "identifier"},
    {"name": "password", "value": "password", "description": "Operator password.", "sensitivity": "secret"},
    {"name": "member_id", "value": "101555", "description": "Member number.", "sensitivity": "identifier"},
    {"name": "share_type", "value": "Holiday Club", "description": "Type of share to open."},
    {"name": "initial_deposit", "value": "25.00", "description": "Initial deposit in dollars."}
  ],
  "outputs": [
    {"name": "confirmation_ref", "description": "Confirmation reference shown after posting.", "sensitivity": "identifier"}
  ],
  "business_outcomes": [
    {"code": "member_not_found", "text": "not found", "http_status": 404, "description": "No member record matches the given member number."},
    {"code": "validation_rejected", "text": "correct the following", "http_status": 400, "description": "The new-share form rejected the submitted values (e.g. deposit below minimum)."}
  ],
  "known_interstitials": [
    {"id": "session_expiry_notice", "text": "session", "http_status": 440, "dismiss_role": "button", "dismiss_name": "Continue", "description": "Session-expiry notice interrupting navigation.", "max_applications": 2}
  ],
  "max_steps": 18
}
