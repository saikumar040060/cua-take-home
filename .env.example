# Anthropic API key used for discovery and customer-chat intent routing.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the discovery model (default: claude-sonnet-4-5)
# CUA_MODEL=claude-sonnet-4-5
# Optional: explicit Chromium executable for Playwright
# CUA_CHROMIUM_PATH=/usr/bin/chromium

# Infrastructure-owned legacy credentials. They are injected after intent
# routing and never accepted from, returned to, or shown to the customer.
MERIDIAN_OPERATOR_ID=teller1
MERIDIAN_OPERATOR_PASSWORD=replace-me
MERIDIAN_SUPERVISOR_ID=super1
MERIDIAN_SUPERVISOR_PASSWORD=replace-me

# Runtime
LOG_LEVEL=INFO
# Optional: pin the session-cookie signing key so customer/employee logins
# survive a process restart. A random key is generated per-process if unset
# (sessions just drop on restart, same as the in-memory run state already does).
# SESSION_SECRET_KEY=
# Set true on any public deployment until real bank SSO/JWT and employee
# authorization are integrated. This blocks write workflows and commands.
PUBLIC_DEMO_READ_ONLY=false
# PORT=10000
